{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "scope", "architecture_constraints", "invariants", "primitives", "contracts", "failure_codes", "failure_rule", "proof_obligations", "implementation_order", "acceptance_gates"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["kind", "id", "version", "status", "path", "source", "authority"],
      "properties": {
        "kind": {"const": "agentbus_participation_contract"},
        "id": {"const": "agentbus-participation-v1"},
        "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["proposed", "active", "superseded"]},
        "path": {"const": "contracts/participation/v1/participation.contract.yml"},
        "source": {"const": "https://github.com/mjgolaszewski/AgentBus/issues/6"},
        "authority": {"const": "normative_for_issue_6_delivery"}
      },
      "additionalProperties": false
    },
    "scope": {"type": "object", "required": ["purpose", "non_goals", "compatibility"]},
    "architecture_constraints": {"type": "object", "minProperties": 8, "required": ["durable_owner", "client_owner", "polling_boundary", "runtime_boundary", "authorization_boundary", "presentation_boundary", "transport_boundary", "governance_boundary"]},
    "invariants": {
      "type": "array", "minItems": 16,
      "items": {
        "type": "object", "required": ["id", "rule"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^INV-[0-9]{3}$"}, "rule": {"type": "string", "minLength": 20}}
      }
    },
    "primitives": {"type": "object", "minProperties": 9},
    "contracts": {
      "type": "object", "minProperties": 8,
      "required": ["join_and_resume", "policy", "poll", "stop", "rename", "presence", "presentation", "authority"]
    },
    "failure_codes": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "failure_rule": {"const": "uncertain_state_never_counts_as_success"},
    "proof_obligations": {
      "type": "array", "minItems": 24,
      "items": {
        "type": "object", "required": ["id", "proves", "scenario"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^PO-[0-9]{2}$"},
          "proves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^INV-[0-9]{3}$"}},
          "scenario": {"type": "string", "minLength": 10}
        }
      }
    },
    "implementation_order": {
      "type": "array", "minItems": 13,
      "items": {
        "type": "object", "required": ["id", "unit", "depends_on"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^IU-[0-9]{3}$"},
          "unit": {"type": "string", "minLength": 5},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^IU-[0-9]{3}$"}}
        }
      }
    },
    "acceptance_gates": {"type": "object", "minProperties": 9}
  }
}
