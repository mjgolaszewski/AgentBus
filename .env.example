# Create a Slack app using slack-app-manifest.json and install it to your workspace.
# Invite its bot to ONE channel. Keep real tokens in .env; do not commit them.
AGENTBUS_SLACK_BOT_TOKEN=
# App-level token with connections:write, generated separately in Slack app settings.
AGENTBUS_SLACK_APP_TOKEN=
AGENTBUS_SLACK_CHANNEL=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENTBUS_API_TOKEN=

# Native devcontainer service defaults. Start explicitly with agentbus start,
# or set AUTOSTART=1 to start when the devcontainer opens.
AGENTBUS_AUTOSTART=0
AGENTBUS_HOST=127.0.0.1
AGENTBUS_PORT=8766
AGENTBUS_URL=http://127.0.0.1:8766
# State defaults to .devcontainer/agentbus/.state (persists on the /docker mount).
# AGENTBUS_STATE_DIR=.devcontainer/agentbus/.state
# AGENTBUS_DB_PATH=.devcontainer/agentbus/.state/messages.sqlite3
