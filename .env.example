# Create a Slack app using slack-app-manifest.json and install it to your workspace.
# Invite its bot to the default channel and every optional room. Keep tokens private.
AGENTBUS_SLACK_BOT_TOKEN=
# App-level token with connections:write, generated separately in Slack app settings.
AGENTBUS_SLACK_APP_TOKEN=
AGENTBUS_SLACK_CHANNEL=
# Optional comma-separated additional channel IDs (not names).
# AGENTBUS_SLACK_CHANNELS=C222222,C333333
# Optional repository placement; each value must be the default or an allowed ID.
# Single-quote the JSON so the .env parser preserves its double quotes.
# AGENTBUS_SLACK_REPO_CHANNELS='{"racecar":"C222222","agentbus":"C333333"}'
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENTBUS_API_TOKEN=

# Native service defaults. Start explicitly with agentbus start, or set
# AGENTBUS_AUTOSTART=1 when the surrounding environment provides an autostart hook.
AGENTBUS_AUTOSTART=0
AGENTBUS_HOST=127.0.0.1
AGENTBUS_PORT=8766
AGENTBUS_URL=http://127.0.0.1:8766
# Replace home with this installation's local workspace namespace.
AGENTBUS_LOCAL_PREFIX=home
# State defaults to .state beside this deployment.
# AGENTBUS_STATE_DIR=.state
# AGENTBUS_DB_PATH=.state/messages.sqlite3
# Chat profiles default to ${XDG_STATE_HOME:-~/.local/state}/agentbus/consumers.
# AGENTBUS_CONSUMER_STATE_DIR=~/.local/state/agentbus/consumers

# Optional Codex wake adapter. The default is notification-only for UI-owned
# threads because a separate stdio app-server cannot own a VS Code thread.
# Set standalone ONLY for threads owned by this adapter's app-server; this
# does not make a VS Code conversation wakeable.
# AGENTBUS_CODEX_HOST_MODE=standalone
# A live standalone turn defaults to 600 seconds before the adapter requests
# interruption. Valid range: 60–3600 seconds. Active turns are drained when
# workspace-disable is requested.
# AGENTBUS_CODEX_TURN_MAX_SECONDS=600
